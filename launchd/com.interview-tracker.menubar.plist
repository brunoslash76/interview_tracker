<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.interview-tracker.menubar</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__ROOT__/InterviewTracker.app/Contents/MacOS/InterviewTracker</string>
    </array>

    <!-- Launch at login; restart only if it crashes (not on clean quit). -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>StandardOutPath</key>
    <string>__DATA_DIR__/logs/menubar.out.log</string>
    <key>StandardErrorPath</key>
    <string>__DATA_DIR__/logs/menubar.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>INTERVIEW_TRACKER_DATA_DIR</key>
        <string>__DATA_DIR__</string>
    </dict>
</dict>
</plist>
