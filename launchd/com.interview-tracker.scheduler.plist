<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.interview-tracker.scheduler</string>

    <!-- install.sh renders these placeholders into an installed LaunchAgent. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__ROOT__/bin/scan_gmail.sh</string>
    </array>

    <!-- 09:00 and 20:00 local system time (America/Sao_Paulo). -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>WorkingDirectory</key>
    <string>__ROOT__</string>
    <key>StandardOutPath</key>
    <string>__DATA_DIR__/logs/scheduler.out.log</string>
    <key>StandardErrorPath</key>
    <string>__DATA_DIR__/logs/scheduler.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>INTERVIEW_TRACKER_DATA_DIR</key>
        <string>__DATA_DIR__</string>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
