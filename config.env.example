# Copied to the private data directory by install.sh / install-linux.sh / install.ps1.
# macOS default: ~/Library/Application Support/InterviewTracker/config.env
# Linux default:  ~/.local/share/InterviewTracker/config.env
# Windows default: %LOCALAPPDATA%\InterviewTracker\config.env
# Keep credentials and private notification topics out of this repository.

# Set when background jobs (launchd, systemd, Task Scheduler) cannot find `claude` on PATH.
CLAUDE_BIN=claude

# Optional: a private ntfy topic for iPhone and Apple Watch notifications.
NTFY_TOPIC=
