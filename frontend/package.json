{
  "name": "interview-tracker-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "serve-storybook-static": "http-server storybook-static -a 127.0.0.1 -p 6007 -c-1 --silent",
    "test:storybook": "test-storybook",
    "test:storybook:run": "test-storybook --url http://127.0.0.1:6007",
    "test:storybook:static": "start-server-and-test serve-storybook-static http://127.0.0.1:6007/index.json test:storybook:run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^6.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@storybook/test": "^8.6.14",
    "@storybook/test-runner": "^0.22.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitest/coverage-v8": "^3.1.4",
    "http-server": "^14.1.1",
    "jsdom": "^26.1.0",
    "start-server-and-test": "^2.0.11",
    "storybook": "^8.6.14",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
